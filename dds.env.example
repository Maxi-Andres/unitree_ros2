# DDS transport for every service in this repo (executor + camera bridge).
# Copy to dds.env and adjust; setup.sh sources it. The AI-VL page writes this file
# through the executor's POST /dds, so hand-editing is only for setup or debugging.

# Host interface CycloneDDS binds to. Keep the WIRED one even when the robot is on
# WiFi, as long as this machine routes to the robot's network.
CYCLONEDDS_IFACE=enp4s0

# Robot IPs for UNICAST discovery, comma-separated. REQUIRED whenever the robot is not
# on the same subnet as this machine: DDS discovery is multicast, multicast is
# link-local, and a router does not forward it — so on another VLAN the robot is
# invisible until it is named here by IP. Leave empty on a flat wired LAN.
#   wired robot:  ROBOT_DDS_PEERS=
#   robot's wlan0 on another VLAN:  ROBOT_DDS_PEERS=192.168.51.115
ROBOT_DDS_PEERS=
