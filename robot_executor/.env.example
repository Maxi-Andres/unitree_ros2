# robot_executor configuration — copy to `.env` and adjust.
# (The .env is read at startup; environment variables override it.)

# HTTP server the AI-VL backend forwards commands to (host-networked container).
EXECUTOR_HOST=0.0.0.0
EXECUTOR_PORT=8090

# Which robot this executor drives by default (only "go2" is wired today).
DEFAULT_ROBOT=go2

# Robot IP — informational (for ping/health). The ACTUAL DDS link is the network
# interface set by `source /workspace/setup.sh` (CYCLONEDDS_URI, e.g. enp4s0), NOT
# this IP. Go2 default wired IP:
ROBOT_IP=192.168.123.161

# SAFETY fallback: block acrobatics (flips, handstand, walk-upright)?
# Default off. This is only used when a request doesn't carry its own safe_mode;
# the page's "Safe" toggle overrides it per command.
SAFE_MODE=true

# Build + log the command but DO NOT publish (test the plumbing without moving the
# robot). Set to false to actually move it.
DRY_RUN=false

# Motion tuning for walk/turn.
MOVE_RATE_HZ=10
DEFAULT_STEP_S=2.0
MAX_STEP_S=10.0

# --- Remote command transport (WAN) ---------------------------------------------------
# dds (default) publishes DDS from THIS machine, which only works while the robot shares
# this machine's L2 segment. relay sends the command over HTTP to an agent running ON the
# robot, which publishes DDS locally — the only thing that works once the robot is
# itinerant. "auto" = use the relay if a URL is set. See robot-command-relay/.
GO2_TRANSPORT=dds
# The robot's high-level computer. Over the IR1101 VPN this becomes 10.1.254.18.
GO2_RELAY_URL=http://192.168.123.18:8092
# Same token as ~/.relay_token ON THE ROBOT. Not the Splunk one.
RELAY_TOKEN=paste-the-robot-side-token-here
