# robot_camera_bridge configuration — copy to `.env` and adjust.

# Which robot's camera to stream: go2 | g1 | stream | test
#   stream = read the video over HTTP, no DDS (see the WAN section below)
#   test   = synthetic moving frame (verify the pipeline without a robot)
CAMERA_ROBOT=go2

# Backend WebSocket that fans frames straight to the monitors (no YOLO).
# Host-networked container -> localhost; wss with the self-signed cert.
BACKEND_WS_URL=wss://localhost:8443/ws/robot-cam

# Control HTTP (the Monitor button hits this through the backend).
CAMERA_CONTROL_HOST=0.0.0.0
CAMERA_CONTROL_PORT=8091

# Start streaming immediately on launch (else wait for /start).
START_STREAMING=false

# --- Latency / quality knobs ---
# Go2: poll rate (Hz) for the video API (GetImageSample). Each poll = one JPEG frame.
GO2_VIDEO_FPS=15
# JPEG quality for the G1/test sources (the Go2 returns its own JPEG). 1-100.
JPEG_QUALITY=70

# --- G1 (or any ROS2 camera) ---
# sensor_msgs/Image topic to read for the G1. Set this once the G1's camera node
# is publishing (e.g. a RealSense: /camera/color/image_raw).
G1_IMAGE_TOPIC=/camera/color/image_raw

# Test source frame rate.
TEST_FPS=15

# --- WAN source: no DDS, works when the robot is on ANOTHER network -------------------
# Set CAMERA_ROBOT=stream to read the video that ALREADY left the robot instead of its DDS.
# DDS cannot cross a subnet boundary on these robots (measured: 122 topics from the robot's
# own subnet, 2 from another one), so "go2"/"g1" only work while the robot shares this
# machine's L2 segment. "stream" has no such limit — it is a plain HTTP URL.
#
# Point this at the ROBOT's own MJPEG server (robot-nvr-bridge/robot/mjpeg_server.py), not
# at Frigate: Frigate is an NVR and buffers on purpose, which measured ~7 s of latency. The
# robot's server is the short path — camera -> JPEG -> HTTP -> here, nothing re-encoded.
# Frames arrive already JPEG, so with STREAM_QUALITY=0 they are forwarded untouched.
#   robot direct : http://<robot>:8093/stream     <- low latency, use this
#   via Frigate  : http://127.0.0.1:5000/api/robot   <- only if the robot server is off
STREAM_URL=http://192.168.123.18:8093/stream
STREAM_FPS=10
STREAM_RESOLUTION=native
STREAM_QUALITY=0
