# robot_camera_bridge configuration — copy to `.env` and adjust.

# Which robot's camera to stream: go2 | g1 | stream | test
#   stream = read the video over HTTP, no DDS (see the WAN section below)
#   test   = synthetic moving frame (verify the pipeline without a robot)
CAMERA_ROBOT=go2

# Backend WebSocket that fans frames straight to the monitors (no YOLO).
# Host-networked container -> localhost; wss with the self-signed cert.
BACKEND_WS_URL=wss://localhost:8443/ws/robot-cam

# Control HTTP (the Monitor button hits this through the backend).
CAMERA_CONTROL_HOST=0.0.0.0
CAMERA_CONTROL_PORT=8091

# Start streaming immediately on launch (else wait for /start).
START_STREAMING=false

# --- Latency / quality knobs ---
# Go2: poll rate (Hz) for the video API (GetImageSample). Each poll = one JPEG frame.
GO2_VIDEO_FPS=15
# JPEG quality for the G1/test sources (the Go2 returns its own JPEG). 1-100.
JPEG_QUALITY=70

# --- G1 (or any ROS2 camera) ---
# sensor_msgs/Image topic to read for the G1. Set this once the G1's camera node
# is publishing (e.g. a RealSense: /camera/color/image_raw).
G1_IMAGE_TOPIC=/camera/color/image_raw

# Test source frame rate.
TEST_FPS=15

# --- WAN source: no DDS, works when the robot is on ANOTHER network -------------------
# Set CAMERA_ROBOT=stream to read the video that ALREADY left the robot instead of its DDS.
# DDS cannot cross a subnet boundary on these robots (measured: 122 topics from the robot's
# own subnet, 2 from another one), so "go2"/"g1" only work while the robot shares this
# machine's L2 segment. "stream" has no such limit — it is a plain HTTP URL.
#
# The URL picks the reader, so this one setting also decides how much the robot has to
# send and how old the picture is when it gets here. Four options, MEASURED, in order:
#
# ⚠️ WHICH ONE IS RIGHT DEPENDS ON THE LINK, and both numbers below were measured on the same
# day over LTE. On a HEALTHY link (RTT ~45 ms) the robot's own MJPEG wins by 260 ms: 14.31 fps
# at 89 ms against ~349 ms for WHEP, because WHEP rides the SRT receive buffer (105 ms) plus
# the encode, mediamtx and a jitter buffer. On a LOSSY link (RTT 165-384 ms, ~0.93 Mbps) that
# same MJPEG collapses to 1.90-4.5 fps, because one TCP loss blocks everything behind it, and
# WHEP is the only one still delivering. Measure the link, then pick — and never run both at
# full rate: with the MJPEG uncapped the H.264 goes from 8 to 433 unrecoverable drops per 31 s.
#
#   https://127.0.0.1:8889/robot/whep      <- for a LOSSY link. mediamtx re-serving over
#       WebRTC the H.264 the robot already encodes. Two wins in one line:
#         * the robot sends ONE stream instead of two. Its MJPEG is a second full copy over
#           the field link — 0.170 Mbps of a ~0.93 Mbps LTE uplink measured 2026-09-16, and
#           it is the branch that starves the other: over TCP every lost packet blocks
#           everything queued behind it, so MJPEG arrived at 4.5 fps while the H.264 over
#           SRT arrived at 14.2.
#         * it is the only reader of this stream measured in milliseconds: WHEP 200 ms
#           against 2455 ms for RTSP below. Same server, same stream, same moment.
#       Costs a decode + JPEG encode here, on the workstation that has the headroom.
#
#   rtsp://127.0.0.1:8554/robot            <- the same stream, 2455 ms of FIXED delay when
#       read with OpenCV (measured 2026-09-15 two ways, constant from the first frame, and
#       unmoved by every FFmpeg option tried). Fine for recording, never for driving.
#
#   http://<robot>:8093/stream             <- for a HEALTHY link, and the current setting.
#       The robot's own MJPEG server: shortest path, no decode, no SRT buffer — 89 ms p50
#       measured end to end (its COM stamp against the robot's own clock). It is a SECOND
#       full-rate copy off the robot (0.77 Mbps at 480x270 uncapped), so it is the one to
#       turn down, or off, the moment the link stops keeping up.
#       Retune it LIVE, without restarting anything: POST /config {width, fps, quality} to
#       the robot's :8093.
#
#   http://127.0.0.1:5000/api/robot        <- via Frigate. Needs no decode here, but Frigate
#       is an NVR and buffers on purpose: ~7 s measured. Only as a last resort.
STREAM_URL=https://127.0.0.1:8889/robot/whep
# 30, NOT 15, and this is not "as fast as possible" — it is what stops the gate from
# becoming the limiter. WebRTC delivers in bursts (a frame pair 20 ms apart, then a gap), and
# the gate enforces a MINIMUM SPACING of 0.9 periods: at 15 fps that is 60 ms, so the second
# frame of every burst is thrown away. MEASURED 2026-09-16 on the live stream, same moment,
# only this value changed: 15 -> 7.9 fps forwarded, 30 -> 11.9 fps, from a source delivering
# 13.5. The cap is the source's own rate now; this one just has to stay out of its way.
STREAM_FPS=30
# The picture is 1080p on the WHEP path (the MJPEG one arrived pre-shrunk by the robot,
# because it crossed the link; this one does not cross anything). Downscale for what the
# consumers want, not for what an uplink survives: 720p is the drive view and YOLO's 640
# with room to spare. Live-tunable through the bridge's /config.
STREAM_RESOLUTION=720p
STREAM_QUALITY=0

# CA bundle for the WHEP endpoint's certificate. mediamtx serves WHEP over HTTPS with the
# self-signed cert it generates for itself (`auto.crt`), which no store can verify — so
# point this at that file when mediamtx is on ANOTHER machine. Left empty, verification
# stays ON for every remote host and is skipped only for a loopback address, where there is
# no network between us and the server for a certificate to protect.
STREAM_TLS_CA=

# --- DRIVE BRANCH: all-intra H.264 relayed to the backend, not decoded here ------------
# Empty = off (the default). Needs H264_ENABLE=1 on the robot and a browser that decodes with
# WebCodecs; the bytes pass through this tier untouched.
#
# WHY IT EXISTS, measured on the robot 2026-09-21: 4207 B per frame against ~9000 for the JPEG
# at the same quality, and 14.5 fps against the MJPEG's 10 — more frames for a third less
# bandwidth. Every frame is a keyframe, so a lost one costs ONE frame instead of freezing until
# the next IDR, which is what lets it ride a link with no retransmission.
#
# It does NOT replace STREAM_URL: that one still feeds YOLO and the VLM, which decode JPEGs.
#   H264_URL=http://10.1.254.18:8093/h264
H264_URL=
H264_WS_URL=wss://localhost:8443/ws/robot-h264

# Carry the robot -> HQ hop of the drive branch over UDP on this port instead of TCP.
# Empty or 0 = TCP (the default). Needs a robot whose mjpeg_server knows `/h264?udp=`.
#
# WHY, measured over Starlink 2026-09-23: on TCP one lost packet froze the whole view until it
# was retransmitted — 10 stalls of 250-916 ms in 150 s. Over UDP the same loss costs single
# frames (runs of 1-4, ~280 ms at worst), and one XOR parity per frame recovers ~4% more.
# The robot sends ONLY while this relay holds its lease open, and only to this machine's
# address; if no datagram arrives the relay falls back to TCP for 60 s and tries again.
# The port must be free on this host (8890-8892 are mediamtx and the SRT bridge).
#   H264_UDP_PORT=8895
H264_UDP_PORT=
